{
  "name": "prompt-polish",
  "version": "1.0.0",
  "private": true,
  "description": "dsh 提示词优化助手：发送前调用专门的提示词工程 agent 润色/补全/扩写命令，支持重写、多轮改写与撤回（动态 client 插件，随 harness 启动自动加载）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "prompt-optimizer",
    "llm"
  ],
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
